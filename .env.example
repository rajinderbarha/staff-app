# Fuvay Staff App — Environment Variables
# Copy to .env before running with Expo

# ── Backend connection ──────────────────────────────────────────────────────
# iOS simulator or web (same machine as backend):
EXPO_PUBLIC_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Android emulator (replace the line above; 10.0.2.2 is host loopback):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical device (replace with your computer's local IP address):
# Find it with: ipconfig (Windows) | ifconfig (Mac/Linux) | ip addr (Linux)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000

# Staging / Production:
# EXPO_PUBLIC_ENV=production
# EXPO_PUBLIC_API_BASE_URL=https://api.serviceos.in
