{
  "expo": {
    "name": "Fuvay Staff",
    "slug": "serviceos-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.serviceos.staff",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Fuvay needs location to track your jobs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.serviceos.staff",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/fuvay-logo-native.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F8F7",
          "dark": {
            "image": "./assets/fuvay-logo-native-dark.png",
            "backgroundColor": "#1C1C1E"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3e002424-d662-48f1-a0b1-bb4c9dc460f5"
      }
    },
    "owner": "trainee05"
  }
}
